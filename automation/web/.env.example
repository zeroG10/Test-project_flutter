# automation/web/.env — copy this file to `.env` (gitignored) for local runs.
# CI does not read it: the workflow sets BASE_URL from the WEB_BASE_URL
# repository variable and refuses to run when it is empty.

# Target environment (dev/staging, never production). Replace the whole <…>
# placeholder — left as-is, playwright.config.ts refuses to start (fail-closed).
BASE_URL=<https://your-app.example.com>

# Auth by state (automation/README.md → Determinism rules): tests/auth.setup.ts signs in
# through the UI once per role and saves playwright/.auth/<role>.json; the chromium /
# firefox projects start from that state. Never commit real credentials.
# Root (required for every authenticated project — a missing value fails setup loudly):
APP_USER_EMAIL=
APP_USER_PASSWORD=
# Manager (optional): leave both empty and no manager state is created; specs that call
# asManager() then fail with "Blocked: manager state missing". Set both or neither.
APP_MANAGER_EMAIL=
APP_MANAGER_PASSWORD=

# API origin for login-by-API and data seeding/cleanup from UI tests (pattern:
# examples/automation/web/utils/api.ts; spec: docs/api/openapi.json). Leave empty if the
# UI suite never touches the API. API tests themselves live in automation/api/.
API_BASE_URL=

# Email-driven flows (set-password link, reset link) — playwright/utils/mailbox.ts.
# `none` (default) = every mailbox call is Blocked with a pointer to
# docs/notes/email-automation-setup.md. Reserved, not implemented yet: mailosaur | mailslurp | imap.
MAILBOX_PROVIDER=none
# Domain whose inbox the provider can read; utils/data.ts → testEmail() builds
# qa+<unique>@<domain>. Required only when a spec asks for a test email.
TEST_MAILBOX_DOMAIN=
# Provider keys (uncomment with the matching MAILBOX_PROVIDER; never commit values):
# MAILOSAUR_API_KEY=
# MAILOSAUR_SERVER_ID=
# MAILSLURP_API_KEY=
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=

# Optional additional JSON/header fields to mask in helper diagnostics (comma-separated).
# Names are case-insensitive; underscores and hyphens are ignored.
QA_REDACT_FIELDS=
