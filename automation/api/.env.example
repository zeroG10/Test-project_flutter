# API endpoint — dev/staging target, never production. Replace the whole <…>
# placeholder: left as-is or empty, conftest.py refuses to start a session
# (fail-closed, like BASE_URL in automation/web — a run without a target is Blocked).
API_BASE_URL=<https://api.example.com>
API_TIMEOUT_SECONDS=30

# Auth (choose what your API uses)
API_TOKEN=
API_USERNAME=
API_PASSWORD=

# Environment label (dev / staging) — used in reports and in the traceability run
# context. CI refuses anything but dev|staging (.github/workflows/api-tests.yml).
API_ENV=staging

# ── Security module (modules.security in setup/project.yaml) ──────────────
# Two DIFFERENT users of the same tenant class, for the IDOR access-control
# matrix. Leave empty to skip those tests — a skip here is Blocked, not a pass.
USER_A_TOKEN=
USER_B_TOKEN=
# ';'-separated GET path templates with {id}, e.g. /orders/{id};/profile/{id}
IDOR_RESOURCES=
# ';'-separated ids owned by USER A, aligned with IDOR_RESOURCES
IDOR_RESOURCE_IDS=

# Optional additional JSON/header fields to mask in helper diagnostics (comma-separated).
# Names are case-insensitive; underscores and hyphens are ignored.
QA_REDACT_FIELDS=
