# Appium server
APPIUM_HOST=127.0.0.1
APPIUM_PORT=4723

# OS the driver talks to: android | ios   (pytest --platform=... overrides this per run)
PLATFORM=android

# What the build is: native | flutter.
# Flutter apps are driven by the NATIVE drivers (UiAutomator2 / XCUITest) through
# Semantics(identifier:) — same screen maps, works on release builds. See README "Flutter strategy".
APP_KIND=native

# Flutter builds only: native | integration.
# integration = appium-flutter-integration-driver (automationName FlutterIntegration),
# an opt-in fallback for DEBUG builds that compile in the appium_flutter_server package.
FLUTTER_DRIVER=native

# Deprecated alias, still honoured with a warning: FLUTTER_ENABLED=true == APP_KIND=flutter
# FLUTTER_ENABLED=false

# Explicit-wait default in seconds (helpers/waits.py). No implicit wait is ever set.
DEFAULT_TIMEOUT=15

# Android — put the build in builds/android/ (see builds/README.md)
ANDROID_DEVICE_NAME=Pixel_7_API_35
ANDROID_PLATFORM_VERSION=15
ANDROID_APP_PATH=./builds/android/app-debug.apk
ANDROID_APP_PACKAGE=com.example.app
ANDROID_APP_ACTIVITY=com.example.app.MainActivity

# iOS — .app (simulator) or .ipa (device) in builds/ios/
IOS_DEVICE_NAME=iPhone 17
IOS_PLATFORM_VERSION=26.5
IOS_APP_PATH=./builds/ios/App.app
IOS_BUNDLE_ID=com.example.app
